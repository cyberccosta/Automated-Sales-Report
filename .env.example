# Copie este arquivo para ".env" e preencha. NUNCA suba o .env para o GitHub.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email@gmail.com
# No Gmail, use uma "senha de app" (exige verificação em duas etapas), não a senha normal
SMTP_PASSWORD=sua_senha_de_app
# Um ou mais destinatários, separados por vírgula
EMAIL_DESTINO=responsavel@empresa.com
